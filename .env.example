# Django origin (without /api). Restart Next.js after changing this value.
BACKEND_API_ORIGIN=https://api.bizfindly.com

# Google OAuth Web client ID (same as Django GOOGLE_OAUTH_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Google Maps Embed API key for the map on place pages. Without it the
# map still works via Google's keyless embed endpoint. The Embed API itself is
# not charged per load, but the key needs a billing-enabled Cloud project.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Google Maps JavaScript API key for the map on /ai. Required for that map to
# render: it needs a billing-enabled Cloud project, and map loads are charged.
# Restrict the key to your domains — this value ships to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
